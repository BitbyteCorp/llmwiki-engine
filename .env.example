# Local image / compose configuration. Copy to .env; never commit secrets.
NODE_ENV=production
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# Set a random secret locally before starting the production-mode image.
SESSION_SECRET=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LUNA_MODEL=gpt-6-luna
LUNA_REASONING_EFFORT=medium
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KNOWLEDGE_REPO_URL=
GIT_SSH_KEY_PATH=
GIT_BOT_NAME=Luna
GIT_BOT_EMAIL=luna@llmwiki.local
DREAM_CRON=0 3 * * *
TZ_DREAM=Asia/Seoul
# Source development only; production images refuse this setting.
DEV_LOGIN_EMAIL=
METRICS_TOKEN=
SLACK_WEBHOOK_URL=
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH=30
RATE_LIMIT_USER=60
AUTH_CLEANUP_INTERVAL_MS=300000
SEARCH_RERANK=off
SEARCH_EXPAND=off
INDEX_POLL_SECONDS=60
LUNA_MODELS=
UPLOAD_RETENTION_DAYS=7
