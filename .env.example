# Local configuration for `pnpm dev`, `pnpm cli` and compose. Copy to .env; never commit secrets.
# NODE_ENV is not set here: `pnpm dev` pins development, the image and compose pin production.
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# Set false for copied databases to keep queued jobs and background OpenAI work paused.
JOBS_AUTOSTART=true
# Set a random secret locally before starting the production-mode image.
SESSION_SECRET=
# openai or openrouter; OPENAI_API_KEY holds the selected provider's key.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 도니와 임베딩의 재시도 횟수는 0 이상의 정수이며 0이면 재시도하지 않는다.
OPENAI_MAX_RETRIES=8
# Comma-separated selectable models; the first entry is the default.
LLM_MODELS=gpt-6-luna
LLM_REASONING_EFFORT=high
# 요약·쓰기·서브에이전트·충돌 해결·꿈꾸기의 추론 강도이며 none, minimal, low, medium, high, xhigh, max를 허용한다.
LLM_BACKGROUND_REASONING_EFFORT=low
# 도니 입력 문맥이 이 토큰 수에 도달하면 압축하며 양의 정수만 허용한다.
LLM_COMPACT_THRESHOLD=50000
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KNOWLEDGE_REPO_URL=
GIT_SSH_KEY_PATH=
GIT_BOT_NAME=도니
GIT_BOT_EMAIL=dony@llmwiki.local
DREAM_CRON=0 3 * * *
TZ_DREAM=Asia/Seoul
# Source development only; production images refuse this setting.
DEV_LOGIN_EMAIL=
METRICS_TOKEN=
SLACK_WEBHOOK_URL=
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH=30
RATE_LIMIT_USER=60
AUTH_CLEANUP_INTERVAL_MS=300000
SEARCH_RERANK=off
SEARCH_EXPAND=off
INDEX_POLL_SECONDS=60
UPLOAD_RETENTION_DAYS=7
