# Local configuration for `pnpm dev`, `pnpm cli` and compose. Copy to .env; never commit secrets.
# NODE_ENV is not set here: `pnpm dev` pins development, the image and compose pin production.
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# Set false for copied databases to keep queued jobs and background OpenAI work paused.
JOBS_AUTOSTART=true
# Set a random secret locally before starting the production-mode image.
SESSION_SECRET=
# openai, openrouter, openai-codex 중 LLM 제공자를 고른다. Codex 로그인은 docs/codex-oauth.md를 따른다.
LLM_PROVIDER=openai
# OpenAI/OpenRouter LLM과 임베딩의 API 키다. Codex에서도 임베딩에는 Platform API 키가 필요하다.
OPENAI_API_KEY=
# API 키 기반 API 주소다. Codex에서는 임베딩 주소만 바꾼다.
OPENAI_BASE_URL=
# Codex Responses 전용 주소이며 OPENAI_BASE_URL과 독립적이다.
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
# 도니와 임베딩의 SDK 재시도 횟수는 0 이상의 정수이며 0이면 끈다. Codex 401 갱신 한 번은 별개다.
OPENAI_MAX_RETRIES=8
# 쉼표로 구분한 선택 가능 모델이며 첫 항목이 기본이다. OpenRouter 기본 모델은 openai/gpt-6-luna다.
LLM_MODELS=gpt-6-luna
LLM_REASONING_EFFORT=high
# 요약·쓰기·서브에이전트·충돌 해결·꿈꾸기의 추론 강도이며 none, minimal, low, medium, high, xhigh, max를 허용한다.
LLM_BACKGROUND_REASONING_EFFORT=low
# openai에서만 도니 입력 문맥이 이 토큰 수에 도달하면 압축한다. 양의 정수만 허용한다.
LLM_COMPACT_THRESHOLD=50000
# Codex는 임베딩을 제공하지 않는다. OpenRouter 기본 임베딩 모델은 openai/text-embedding-3-small이다.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KNOWLEDGE_REPO_URL=
GIT_SSH_KEY_PATH=
GIT_BOT_NAME=도니
GIT_BOT_EMAIL=dony@llmwiki.local
DREAM_CRON=0 3 * * *
TZ_DREAM=Asia/Seoul
# Source development only; production images refuse this setting.
DEV_LOGIN_EMAIL=
METRICS_TOKEN=
SLACK_WEBHOOK_URL=
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH=30
RATE_LIMIT_USER=60
AUTH_CLEANUP_INTERVAL_MS=300000
# 질의 확장·재정렬도 선택한 LLM 제공자를 쓰며 SDK 재시도 0회·타임아웃 5초를 유지한다.
SEARCH_RERANK=off
SEARCH_EXPAND=off
INDEX_POLL_SECONDS=60
UPLOAD_RETENTION_DAYS=7
