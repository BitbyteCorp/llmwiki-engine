{
  "name": "llmwiki-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "llmwiki": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --import @swc-node/register/esm-register src/main.ts",
    "build": "next build web && tsc -p tsconfig.build.json && node scripts/build-assets.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "cli": "node --env-file-if-exists=.env --import @swc-node/register/esm-register src/cli.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
